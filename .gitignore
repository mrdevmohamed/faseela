# Rust
pkgmgr/target/
**/*.rs.bk

# Build scratch & outputs
build/
out/
*.dpm.tar.zst
*.dpm.tar

# Bootstrap artifacts
bootstrap/seed/seed-root/
bootstrap/seed/seed.tar*
/mnt/
/lfs/

# Misc
*.log
.DS_Store

__pycache__/
*.pyc

# Vendored crates (scripts/vendor-dpm.sh) must be committed verbatim: cargo
# verifies a checksum for every file, so a build/, out/ or *.log directory or
# file dropped by the patterns above breaks the offline build. Keep LAST.
!/pkgmgr/vendor/
!/pkgmgr/vendor/**
