--- a/bootstrap/final-root.sh
+++ b/bootstrap/final-root.sh
@@ -44,7 +44,11 @@
     final_root_enabled || return 0
     mkdir -p "$FINAL_ROOT"
     repair_final_layout
-    "$NAWA_BIN" --root "$FINAL_ROOT" install --force "$1"
+    # The archive was built a moment ago by this script, so it is unsigned by
+    # construction. The final root already trusts dist/nawa.pub (stage 2 puts
+    # it there; a resumed stage 2 or stage 3 meets it again), and nawa then
+    # refuses unsigned archives: pass --allow-unsigned explicitly.
+    "$NAWA_BIN" --root "$FINAL_ROOT" install --force --allow-unsigned "$1"
 }
 
 # Newest archive of package $1 from the known build dirs / the local cache.
--- a/bootstrap/stage2-inner.sh
+++ b/bootstrap/stage2-inner.sh
@@ -319,7 +319,8 @@
         echo "stage2-inner: no archive built for $pkg" >&2
         exit 1
     fi
-    "$NAWA_BIN" --root / install --force "$archive"
+    # locally built, hence unsigned (a seed rootfs may already trust dist/nawa.pub)
+    "$NAWA_BIN" --root / install --force --allow-unsigned "$archive"
     switch_to_new_glibc
     smoke_check "$pkg"
     install_final "$archive"
--- a/bootstrap/stage3-inner.sh
+++ b/bootstrap/stage3-inner.sh
@@ -118,7 +118,8 @@
     # diagnostic below could run — the check must stay reachable
     ARCHIVE=$(ls /build3/out/"$pkg"-[0-9]*.nawa.tar.zst 2>/dev/null | sort -V | tail -1 || true)
     [ -n "$ARCHIVE" ] || { echo "stage3: no archive built for $pkg" >&2; exit 1; }
-    "$NAWA_BIN" --root / install --force "$ARCHIVE"
+    # locally built, hence unsigned (see install_final in final-root.sh)
+    "$NAWA_BIN" --root / install --force --allow-unsigned "$ARCHIVE"
     install_final "$ARCHIVE"
 done
 
